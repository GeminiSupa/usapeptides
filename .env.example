# USA Peptides - environment template
#
# Copy to .env.local and fill in. .env*.local is gitignored, so real values
# never reach the repository. Add the same variables in the Vercel project
# under Settings > Environment Variables.
#
# This deployment is standalone. Every credential below belongs to USA
# Peptides only - do not reuse values from any other store's project.

# --- Required -------------------------------------------------------------
# The only three needed for the site and its backend to run.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security - never expose to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: site identity ----------------------------------------------
NEXT_PUBLIC_SITE_URL=

# --- Optional: transactional email ----------------------------------------
# Until these are set, /api/* still records data; it just sends no mail.
# Preferred: Resend API. Never prefix the key with NEXT_PUBLIC_.
RESEND_API_KEY=
# onboarding@resend.dev is suitable only for Resend's initial test. Replace it
# with a sender on your verified domain before emailing customers.
RESEND_FROM=onboarding@resend.dev

# Fallback: any SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ORDER_NOTIFICATION_FROM=
ORDER_NOTIFICATION_TO=

# --- Optional: payments ---------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
NEXT_PUBLIC_PAYPAL_ENV=sandbox
NEXT_PUBLIC_ENABLE_CARD_CHECKOUT=false

# --- Optional: live chat (Chatwoot) ---------------------------------------
# From Chatwoot > Settings > Inboxes > your website inbox > Configuration.
# Cloud is https://app.chatwoot.com; self-hosted is your own domain.
# Both of these ship to the browser, which is fine - the token says which
# inbox to open, not who may write to it.
NEXT_PUBLIC_CHATWOOT_BASE_URL=
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=
# Server-side only. Needed ONLY if that inbox has identity validation on.
# Same screen, shown as the HMAC key.
CHATWOOT_HMAC_SECRET=
# Server-side only. Invent a long random string, then set the Chatwoot webhook
# URL to https://<your site>/api/webhooks/chatwoot?token=<that string>.
# Chatwoot does not sign its webhooks, so this is what keeps the endpoint shut.
CHATWOOT_WEBHOOK_SECRET=
